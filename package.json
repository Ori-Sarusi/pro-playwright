{
  "name": "taskflow-pro-playwright",
  "version": "1.0.0",
  "description": "TaskFlow Pro — Project Management Dashboard with comprehensive Playwright & TypeScript test automation suite",
  "main": "app/server.ts",
  "scripts": {
    "app:start": "ts-node app/server.ts",
    "clean:reports": "npx rimraf allure-results test-results playwright-report",
    "pretest": "npm run clean:reports",
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "allure:serve": "npx allure serve allure-results",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report && npx allure open allure-report",
    "lint": "eslint ."
  },
  "keywords": [
    "playwright",
    "typescript",
    "testing",
    "automation",
    "api-testing",
    "database-testing",
    "ci-cd",
    "page-object-model"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.45.3",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.10",
    "allure-playwright": "^3.10.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
